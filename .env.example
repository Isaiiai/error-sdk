# API
# Note: macOS AirPlay often binds port 5000 — use 5050 if needed
PORT=5050
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/error-tracker
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
CREDENTIALS_ENCRYPTION_KEY=change-me-credentials-encryption-key-32

# Admin
VITE_API_URL=http://localhost:5050/api/v1

# DigitalOcean Spaces (S3-compatible) — never commit real secrets
DO_SPACES_URL=https://your-bucket.region.digitaloceanspaces.com
DO_SPACES_ENDPOINT=https://region.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_ACCESS_KEY=your-access-key
DO_SPACES_SECRET_KEY=your-secret-key
DO_SPACES_BUCKET=your-bucket
DO_SPACES_BASE_PATH=error-trackers-bucket/screenshots
DO_SPACES_CDN_URL=

# GitHub PAT for syncing project versions from commits/tags (never commit real tokens)
GITHUB_PAT=ghp_your_personal_access_token
git_pat=ghp_your_personal_access_token
