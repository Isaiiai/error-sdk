{
  "name": "@isaiiai/error-trackers-js-sdk",
  "version": "1.0.2",
  "description": "Browser TypeScript SDK for Isaii Error Tracker — capture errors, network, page views, support tickets, and maintenance status.",
  "license": "MIT",
  "author": "Isaii AI",
  "homepage": "https://isaii.in",
  "keywords": [
    "error-tracking",
    "monitoring",
    "sdk",
    "browser",
    "typescript",
    "isaii"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.2.4",
    "typescript": "^5.5.4"
  }
}
