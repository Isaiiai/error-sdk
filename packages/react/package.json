{
  "name": "@isaiiai/error-trackers-react",
  "version": "1.0.1",
  "description": "React bindings for Isaii Error Tracker — provider, error boundary, support widget, and maintenance UI.",
  "license": "MIT",
  "author": "Isaii AI",
  "homepage": "https://isaii.in",
  "keywords": [
    "error-tracking",
    "react",
    "error-boundary",
    "monitoring",
    "isaii"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./support": {
      "types": "./dist/support.d.ts",
      "import": "./dist/support.mjs",
      "require": "./dist/support.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "import": "./dist/maintenance.mjs",
      "require": "./dist/maintenance.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.tsx src/support.tsx src/maintenance.tsx --format cjs,esm --dts --external react --external @isaiiai/error-trackers-js-sdk --clean --splitting",
    "dev": "tsup src/index.tsx src/support.tsx src/maintenance.tsx --format cjs,esm --dts --external react --external @isaiiai/error-trackers-js-sdk --watch --splitting",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=17",
    "@isaiiai/error-trackers-js-sdk": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "react": "^18.3.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "@isaiiai/error-trackers-js-sdk": "*"
  }
}
